{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      {"source": "**", "headers": [{"key": "X-Frame-Options", "value": "DENY"}, {"key": "Referrer-Policy", "value": "no-referrer"}]},
      {"source": "sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}
